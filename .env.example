# Optional: copy this file to .env to enable AI Q&A mode.
OPENAI_API_KEY=your-api-key-here
# Leave blank for the OpenAI default; set this for an OpenAI-compatible API.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# RAG defaults. Change only if needed.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Windows hosts where os.symlink() is silently degraded
#
# Some Windows machines (locked-down corporate images, or setups where an
# endpoint-security product hooks CreateSymbolicLinkW) make os.symlink()
# return successfully while only writing a 0-byte file, instead of raising
# OSError. huggingface_hub detects symlink support with a plain
# `try: os.symlink(...) except OSError`, so it concludes "symlinks supported"
# and then writes 0-byte pointers into the model cache. The model download
# then appears to succeed while config.json etc. are empty, and loading fails
# with `json.decoder.JSONDecodeError: Expecting value: line 1 column 1`.
#
# Fix: force huggingface_hub to copy files instead of linking. Optionally also
# set EMBEDDING_MODEL_NAME to a pre-downloaded plain model folder to skip the
# HuggingFace cache entirely.
#
# HF_HUB_DISABLE_SYMLINKS=1
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
# EMBEDDING_MODEL_NAME=D:\path\to\paraphrase-multilingual-MiniLM-L12-v2
